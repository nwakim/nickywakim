<%
/*
  Custom listing template for teaching.qmd.

  Quarto passes this template's output through Markdown, so the HTML it
  produces must have no blank lines and no indented lines (indented lines
  turn into code blocks). Every line break below is therefore kept INSIDE
  a template tag, so the output is one long line of HTML.

  Each course page (teachings/*.qmd) can set these front matter fields:
    quarters:          list of {label, url}; url is optional (no link if missing)
    quarter-style:     CSS class for the quarter bubbles (link-blue, link-green, ...)
    long-description:  full course description (falls back to description)
    note:              optional highlighted note shown above the description
*/
%><table class="table teaching-table"><tbody><%
for (const item of items) {
  const style = item['quarter-style'] || 'link-blue';
  const desc = String(item['long-description'] || item.description || '');
  const paras = desc.split(/\n\s*\n/).map(p => p.trim()).filter(p => p);
%><tr><td class="teaching-image"><%
  if (item.image) {
%><a href="<%= item.path %>"><img src="<%= item.image %>" alt="<%= item.title %>"></a><%
  }
%></td><td class="teaching-info"><div class="teaching-title"><a href="<%= item.path %>"><%= item.title %></a></div><%
  if (item.quarters && item.quarters.length) {
%><div class="teaching-quarters"><%
    for (const q of item.quarters) {
%><div class="<%= style %> teaching-quarter"><%
      if (q.url) {
%><a href="<%= q.url %>" target="_blank" rel="noopener"><%= q.label %></a><%
      } else {
%><%= q.label %><%
      }
%></div><%
    }
%></div><%
  }
  if (item.note) {
%><div class="teaching-note"><strong><%= item.note %></strong></div><%
  }
  for (const para of paras) {
%><div class="teaching-description"><%= para %></div><%
  }
%></td></tr><%
}
%></tbody></table>
